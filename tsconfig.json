{
	"compilerOptions": {
		"rootDir": "src",
		"allowJs": true,
		"checkJs": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "react-jsx",
		"target": "es2018",
		"module": "esnext",
		"lib": [
			"dom",
			"esnext"
		],
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"isolatedModules": true,
		/* Strict Type-Checking Options */
		"strict": true,
		/* Additional Checks */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		/* Module Resolution Options */
		"moduleResolution": "node",
		/* This needs to be false so our types are possible to consume without setting this */
		"esModuleInterop": false,
		"resolveJsonModule": true,
		"noImplicitAny": false,
		"typeRoots": [
			"./node_modules/@types"
		],
		"baseUrl": "src",
		"skipLibCheck": true,
		"strictNullChecks": true,
		"types": [],
		"paths": {
			"@doublescale/shared": [
				"shared"
			],
			"@doublescale/shared/*": [
				"shared/*"
			],
			"@doublescale/navigation": [
				"shared/navigation"
			],
			"@doublescale/store": [
				"store/index.ts"
			],
			"@doublescale/config": [
				"shared/config"
			],
			"@doublescale/email-sequences-page": [
				"client/pages/email-sequences-upgrade/index.tsx"
			],
			"@doublescale/client": [
				"client"
			],
			"@doublescale/components": [
				"components"
			],
			"@doublescale/components/*": [
				"components/*"
			],
			"@doublescale/components/ui/*": [
				"shared/ui/*"
			],
			"@doublescale/components/icons/*": [
				"shared/icons/*"
			],
			"@doublescale/utils": [
				"shared/utils"
			],
			"@doublescale/services": [
				"shared/services"
			],
			"@doublescale/services/*": [
				"shared/services/*"
			],
			"@doublescale/hooks/*": [
				"shared/hooks/*"
			],
			"@doublescale/assets": [
				"../assets"
			],
			"@doublescale/assets/*": [
				"../assets/*"
			],
			"@/components/ui/*": [
				"shared/ui/*"
			],
			"@/components/icons/*": [
				"shared/icons/*"
			],
			"@/lib": [
				"shared/lib"
			],
			"@/lib/*": [
				"shared/lib/*"
			],
			"@/types/booking": [
				"types/booking"
			],
			"@/types/booking/*": [
				"types/booking/*"
			],
			"@/hooks/booking": [
				"hooks/booking"
			],
			"@/hooks/booking/*": [
				"hooks/booking/*"
			],
			"@/utils/booking": [
				"utils/booking"
			],
			"@/utils/booking/*": [
				"utils/booking/*"
			],
			"@/stores/booking/event": [
				"stores/booking/event"
			],
			"@/stores/booking/event/*": [
				"stores/booking/event/*"
			],
			"@/config/booking": [
				"config/booking"
			],
			"@/config/booking/*": [
				"config/booking/*"
			],
			"@/constants/booking": [
				"constants/booking.ts"
			],
			"@/renderer/booking": [
				"renderer/booking"
			],
			"@/renderer/booking/*": [
				"renderer/booking/*"
			],
			"@/types/support": [
				"types/support"
			],
			"@/types/support/*": [
				"types/support/*"
			],
			"@/hooks/support": [
				"hooks/support"
			],
			"@/hooks/support/*": [
				"hooks/support/*"
			],
			"@/components/support": [
				"components/support"
			],
			"@/components/support/*": [
				"components/support/*"
			],
			"@/constants/support": [
				"constants/support.ts"
			],
			"@/hooks/*": [
				"shared/hooks/*"
			],
			"@/utils/*": [
				"shared/utils/*"
			],
			"@/stores/blocks-registry": [
				"shared/stores/blocks-registry"
			],
			"@/stores/blocks-registry/*": [
				"shared/stores/blocks-registry/*"
			],
			"@/navigation/*": [
				"shared/navigation/*"
			],
			"@/config/*": [
				"shared/config/*"
			],
			"@/constants/*": [
				"shared/constants/*"
			],
			"@/types/*": [
				"shared/types/*"
			],
			"@/*": [
				"./*"
			]
		}
	},
	"include": [
		"src"
	],
	"exclude": []
}
